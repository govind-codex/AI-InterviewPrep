# Add these values in Vercel: Project Settings > Environment Variables.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ai-resume
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_GENAI_API_KEY=replace-with-your-google-ai-api-key

# Optional. The single-project Vercel deployment uses same-origin /api requests,
# so FRONTEND_URL and VITE_API_BASE_URL are not required.
# FRONTEND_URL=https://your-project.vercel.app
# MONGO_CONNECT_TIMEOUT_MS=10000
